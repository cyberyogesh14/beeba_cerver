PORT=5002

NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/beeba

JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:8081/

# Comma-separated list of allowed CORS origins.
# Development and production frontends can both be listed here.
# The portals that run against this API:
#   client/   (Customer Website)        -> http://localhost:5173
#   admin-web (Admin Dashboard)         -> http://localhost:5174
#   mobile-user / mobile-admin (Expo web) -> http://localhost:8081 / 19006
CLIENT_URLS=http://localhost:5173,http://localhost:5174,https://queqebeebaboys.vercel.app

# ─── Notification Provider ──────────────────────────
# Which provider to use for notification delivery.
# "mock" is the default and requires no external service.
# Set to "sms" or "whatsapp" when real providers are configured.
# The EMAIL channel uses the Email Provider below unless this is
# "mock" (development default), in which case emails are mocked
# and recorded as SENT without contacting an SMTP server.
NOTIFICATION_PROVIDER=mock

# ─── Email Provider (customer emails) ───────────────
# Optional. When EMAIL_HOST / EMAIL_USER / EMAIL_PASS / EMAIL_FROM
# are not configured the EMAIL channel marks notifications as
# FAILED with "Email provider not configured" instead of sending.
# Customer email is not required for token generation; emails are
# only sent to the customer who provided an email address.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# EMAIL_SECURE=true forces TLS. Defaults to true when EMAIL_PORT=465.
EMAIL_SECURE=

# Business name used in customer email copy.
BUSINESS_NAME=Beeba Boys Hair Studio

# ─── Live Queue Media (uploaded images/videos) ───────
# Uploaded media metadata lives in MongoDB; the actual binary files are
# stored via MEDIA_STORAGE_DRIVER. The "local" driver persists files on
# the server disk (MEDIA_UPLOAD_DIR) and serves them at PUBLIC_API_URL
# under /uploads/media/<filename>. Swap the driver to enable object
# storage later without touching the rest of the system.
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=
# Absolute base URL the server is reachable at, used to build public
# media URLs. Production must use the real domain (e.g. https://api.example.com)
# or the live display will not be able to load images/videos.
PUBLIC_API_URL=http://localhost:5002
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200

# ─── Cloudinary (display ads/media storage) ─────────
# Set MEDIA_STORAGE_DRIVER=cloudinary to store uploaded display ads
# (images + videos) in a Cloudinary media library and serve them from the
# Cloudinary CDN instead of the server disk.
#   * Image uploads automatically get a w_400 thumbnailUrl for the admin
#     library (the live display always plays the original, untransformed).
#   * Video uploads get a poster-frame thumbnail + real duration.
#   * Credentials stay on the server (signed uploads via the SDK).
# Get them from -> Cloudinary Dashboard > Account > API Keys.
# MEDIA_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder inside your Cloudinary library for these uploads.
CLOUDINARY_FOLDER=beeba/live-queue

# ─── SMS Provider (optional) ────────────────────────
# Required only when NOTIFICATION_PROVIDER=sms or when
# the SMS channel is used directly.
# Never commit real credentials to version control.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=

# ─── WhatsApp Provider (optional) ───────────────────
# Required only when NOTIFICATION_PROVIDER=whatsapp or
# when the WhatsApp channel is used directly.
# Never commit real credentials to version control.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_PHONE_ID=
